config_version=5

[application]
config/name="Cosmic Conflict"
config/version="1.0.0"
run/main_scene="res://launch.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/use_custom_user_dir=true
; Preserve existing campaign saves and preferences across the rename.
config/custom_user_dir_name="Cosmos Conflict"
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="canvas_items"

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.android="gl_compatibility"
rendering_device/driver.windows="vulkan"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.008, 0.012, 0.025, 1)

[physics]
common/physics_ticks_per_second=60

[shader_globals]

ground_time={
"type": "float",
"value": 0.0
}
ground_motion={
"type": "float",
"value": 1.0
}
sector_ambient={
"type": "vec3",
"value": Vector3(1, 1, 1)
}

[audio]
driver/enable_input=false
